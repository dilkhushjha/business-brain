# Local development defaults. Never commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql://business_brain:business_brain@localhost:5432/business_brain
REDIS_URL=redis://localhost:6379/0

# Required for production connector provisioning.
CONNECTOR_REGISTRATION_KEY=

# Comma-separated exact browser origins. Example:
# https://your-business-brain.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated Host values accepted by the API.
ALLOWED_HOSTS=localhost,127.0.0.1

# API docs are useful locally but disabled by default in production.
ENABLE_API_DOCS=true
MAX_UPLOAD_BYTES=25000000

# Optional LLM provider settings used by the agent layer.
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Reserved for future object-storage integration.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123

# Human dashboard authentication
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
